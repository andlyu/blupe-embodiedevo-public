# Copy to /etc/blupe-embodiedevo/worker.env on the compute host, mode 0600.
# Provision secrets privately. Never commit the populated file.
SITE_ORIGIN=https://blupe-embodiedevo.andlyu.chatgpt.site
WORKER_ID=yam-direct-worker-1
WORKER_TOKEN=
SITE_ACCESS_TOKEN=
RUN_STORE=/home/ubuntu/blupe-embodiedevo/worker-agent/.runs
EMBODIEDEVO_CODEX_HOME=/home/ubuntu/.local/share/blupe-embodiedevo/codex
EMBODIEDEVO_ENABLE_YAM=1
